{
  "name": "smart-campus-lab-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Campus Lab & Resource Optimizer",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && mkdir -p dist && cp -r frontend/dist/* dist/",
    "start": "npm run preview --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^18.0.5"
  }
}
